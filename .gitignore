.venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
cdk.out/
dist/
.env
*.env
out/
# Generated audio, timing and state: rebuild with scripts/build_samples.py. Never commit third-party recordings.
data/*
!data/.gitkeep

# raw Wikipedia text used once to write the place cards (CC BY-SA); the committed cards are our own wording
samples/cards/places.raw.json
samples/cards/places.images.raw.json
samples/cards/images.candidates/
samples/cards/images.candidates.json

# one-off photo candidates for word cards (review sheets); only the approved photos in services/synth/word_photos/ are committed
scripts/_word_photos_work/
# CDK lookup cache (account and hosted-zone ids): regenerated by every synth, not part of the source
infra/cdk.context.json

# Blind rating keys and objective scores: never commit (they reveal which clip is which voice)
*rating KEY*
*rating scores*
polly-voice-scores*.csv
polly-voice-rating-key*.csv
